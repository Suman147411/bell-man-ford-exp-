
#include <stdio.h>

#define MAX 64

void add(int n, int A[MAX][MAX],
         int B[MAX][MAX], int C[MAX][MAX]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            C[i][j] = A[i][j] + B[i][j];
}

void sub(int n, int A[MAX][MAX],
         int B[MAX][MAX], int C[MAX][MAX]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            C[i][j] = A[i][j] - B[i][j];
}

void strassen(int n, int A[MAX][MAX],
              int B[MAX][MAX], int C[MAX][MAX]) {
    if (n == 1) {
        C[0][0] = A[0][0] * B[0][0];
        return;
    }

    int m = n / 2;
    int A11[MAX][MAX] = {0}, A12[MAX][MAX] = {0};
    int A21[MAX][MAX] = {0}, A22[MAX][MAX] = {0};
    int B11[MAX][MAX] = {0}, B12[MAX][MAX] = {0};
    int B21[MAX][MAX] = {0}, B22[MAX][MAX] = {0};
    int M1[MAX][MAX] = {0}, M2[MAX][MAX] = {0};
    int M3[MAX][MAX] = {0}, M4[MAX][MAX] = {0};
    int M5[MAX][MAX] = {0}, M6[MAX][MAX] = {0};
    int M7[MAX][MAX] = {0};
    int X[MAX][MAX] = {0}, Y[MAX][MAX] = {0};

    for (int i = 0; i < m; i++)
        for (int j = 0; j < m; j++) {
            A11[i][j] = A[i][j];
            A12[i][j] = A[i][j + m];
            A21[i][j] = A[i + m][j];
            A22[i][j] = A[i + m][j + m];

            B11[i][j] = B[i][j];
            B12[i][j] = B[i][j + m];
            B21[i][j] = B[i + m][j];
            B22[i][j] = B[i + m][j + m];
        }

    // M1 = (A11 + A22)(B11 + B22)
    add(m, A11, A22, X);
    add(m, B11, B22, Y);
    strassen(m, X, Y, M1);

    // M2 = (A21 + A22)B11
    add(m, A21, A22, X);
    strassen(m, X, B11, M2);

    // M3 = A11(B12 - B22)
    sub(m, B12, B22, Y);
    strassen(m, A11, Y, M3);

    // M4 = A22(B21 - B11)
    sub(m, B21, B11, Y);
    strassen(m, A22, Y, M4);

    // M5 = (A11 + A12)B22
    add(m, A11, A12, X);
    strassen(m, X, B22, M5);

    // M6 = (A21 - A11)(B11 + B12)
    sub(m, A21, A11, X);
    add(m, B11, B12, Y);
    strassen(m, X, Y, M6);

    // M7 = (A12 - A22)(B21 + B22)
    sub(m, A12, A22, X);
    add(m, B21, B22, Y);
    strassen(m, X, Y, M7);

    // C11 = M1 + M4 - M5 + M7
    add(m, M1, M4, X);
    sub(m, X, M5, Y);
    add(m, Y, M7, X);

    // C12 = M3 + M5
    add(m, M3, M5, Y);

    // C21 = M2 + M4
    add(m, M2, M4, X);

    // C22 = M1 - M2 + M3 + M6
    sub(m, M1, M2, Y);
    add(m, Y, M3, X);
    add(m, X, M6, Y);

    for (int i = 0; i < m; i++)
        for (int j = 0; j < m; j++) {
            C[i][j] = X[i][j];
            C[i][j + m] = Y[i][j];
            C[i + m][j] = X[i][j];
            C[i + m][j + m] = Y[i][j];
        }
}

int main(void) {
    int A[MAX][MAX] = {0};
    int B[MAX][MAX] = {0};
    int C[MAX][MAX] = {0};
    int n;

    printf("Enter matrix size (power of 2, max 64): ");
    if (scanf("%d", &n) != 1 ||
        n < 1 || n > MAX || (n & (n - 1)) != 0) {
        printf("Invalid matrix size.\n");
        return 1;
    }

    printf("Enter first matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            if (scanf("%d", &A[i][j]) != 1)
                return 1;

    printf("Enter second matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            if (scanf("%d", &B[i][j]) != 1)
                return 1;

    strassen(n, A, B, C);

    printf("Product matrix:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            printf("%d ", C[i][j]);
        printf("\n");
    }

    return 0;
}
