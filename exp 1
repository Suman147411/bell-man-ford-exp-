
#include <stdio.h>

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

// 1. Merge Sort
void merge(int a[], int l, int m, int r) {
    int temp[1000], i = l, j = m + 1, k = 0;

    while (i <= m && j <= r)
        temp[k++] = (a[i] <= a[j]) ? a[i++] : a[j++];

    while (i <= m) temp[k++] = a[i++];
    while (j <= r) temp[k++] = a[j++];

    for (i = l, k = 0; i <= r; i++, k++)
        a[i] = temp[k];
}

void mergeSort(int a[], int l, int r) {
    if (l < r) {
        int m = l + (r - l) / 2;
        mergeSort(a, l, m);
        mergeSort(a, m + 1, r);
        merge(a, l, m, r);
    }
}

// 2. Quick Sort
int partition(int a[], int low, int high) {
    int pivot = a[high], i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            swap(&a[i], &a[j]);
        }
    }

    swap(&a[i + 1], &a[high]);
    return i + 1;
}

void quickSort(int a[], int low, int high) {
    if (low < high) {
        int p = partition(a, low, high);
        quickSort(a, low, p - 1);
        quickSort(a, p + 1, high);
    }
}

// 3. Bubble Sort
void bubbleSort(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int swapped = 0;

        for (int j = 0; j < n - 1 - i; j++) {
            if (a[j] > a[j + 1]) {
                swap(&a[j], &a[j + 1]);
                swapped = 1;
            }
        }

        if (!swapped) break;
    }
}

// 4. Selection Sort
void selectionSort(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int min = i;

        for (int j = i + 1; j < n; j++)
            if (a[j] < a[min])
                min = j;

        if (min != i)
            swap(&a[i], &a[min]);
    }
}

// 5. Heap Sort
void heapify(int a[], int n, int i) {
    int largest = i;
    int left = 2 * i + 1, right = 2 * i + 2;

    if (left < n && a[left] > a[largest])
        largest = left;

    if (right < n && a[right] > a[largest])
        largest = right;

    if (largest != i) {
        swap(&a[i], &a[largest]);
        heapify(a, n, largest);
    }
}

void heapSort(int a[], int n) {
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(a, n, i);

    for (int i = n - 1; i > 0; i--) {
        swap(&a[0], &a[i]);
        heapify(a, i, 0);
    }
}

// Display array
void display(int a[], int n) {
    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
}

int main(void) {
    int a[1000], n, choice;

    printf("Enter number of elements (1-1000): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 1000) {
        printf("Invalid array size.\n");
        return 1;
    }

    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) {
            printf("Invalid input.\n");
            return 1;
        }
    }

    printf("\n1. Merge Sort");
    printf("\n2. Quick Sort");
    printf("\n3. Bubble Sort");
    printf("\n4. Selection Sort");
    printf("\n5. Heap Sort");
    printf("\nEnter your choice: ");

    if (scanf("%d", &choice) != 1) {
        printf("Invalid choice.\n");
        return 1;
    }

    switch (choice) {
        case 1: mergeSort(a, 0, n - 1); break;
        case 2: quickSort(a, 0, n - 1); break;
        case 3: bubbleSort(a, n); break;
        case 4: selectionSort(a, n); break;
        case 5: heapSort(a, n); break;
        default:
            printf("Invalid choice.\n");
            return 1;
    }

    printf("Sorted array: ");
    display(a, n);

    return 0;
}
